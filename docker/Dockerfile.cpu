FROM python:3.10-slim-bookworm

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --upgrade pip \
    && python -m pip install torch==2.1.2+cpu torchvision==0.16.2+cpu --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install . iopaint

ENV IOPAINT_DEVICE=cpu IOPAINT_MODEL=lama IOPAINT_URL=http://iopaint:8080 MCP_HOST=0.0.0.0 MCP_PORT=8000 MCP_OUTPUT_DIR=/data/output MCP_ALLOWED_ROOTS=/data HF_HOME=/models/huggingface
RUN mkdir -p /data/input /data/output /models
