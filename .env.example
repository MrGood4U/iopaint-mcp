IOPAINT_URL=http://127.0.0.1:28680
IOPAINT_MODEL=lama
IOPAINT_PORT=28680
MCP_HOST=127.0.0.1
MCP_PORT=28681
MCP_OUTPUT_DIR=./runtime/output
# Docker host-visible output directory. The Docker helper sets this automatically.
# MCP_HOST_OUTPUT_DIR=<absolute host path to the project outputs directory>
# Optional: restrict HTTP MCP file access, e.g. /data in Docker.
# MCP_ALLOWED_ROOTS=
# Docker desktop-agent bridge. The Docker helper sets these automatically.
# MCP_HOST_TEMP_DIR=C:\Users\you\AppData\Local\Temp
# MCP_PATH_MAPPINGS=C:\Users\you\AppData\Local\Temp=>/host-temp
# The Docker helper automatically appends the current project's data directory=>/data.
# Optional on Windows/local installations.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
